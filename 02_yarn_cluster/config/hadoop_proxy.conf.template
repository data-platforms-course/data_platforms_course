sub_filter '__NAMENODE_HOST__.__DOMAIN__:19888' '$host:19888';
sub_filter '__NAMENODE_HOST__:9870' '$host:9870';
sub_filter '__SECONDARY_NAMENODE_HOST__:9868' '$host:9868';
sub_filter '__DATANODE_0__:8042' '$host:18042';
sub_filter '__DATANODE_1__:8042' '$host:18043';
sub_filter '__DATANODE_2__:8042' '$host:18044';
sub_filter '__DATANODE_0__:9864' '$host:19864';
sub_filter '__DATANODE_1__:9864' '$host:19865';
sub_filter '__DATANODE_2__:9864' '$host:19866';
sub_filter '__DATANODE_0__.__DOMAIN__:8042' '$host:18042';
