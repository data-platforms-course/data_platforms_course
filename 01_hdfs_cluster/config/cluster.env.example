# Copy this file to cluster.env and adapt it to your environment.
# Do not put private keys, passwords, or tokens in cluster.env.

HDFS_USER="hadoop"
EDGE_HOST="edge"
NAMENODE_HOST="namenode"
SECONDARY_NAMENODE_HOST="namenode"
DATANODE_HOSTS=("datanode-0" "datanode-1" "edge")

# Path on the edge-node, used to reach internal hosts.
INTERNAL_SSH_KEY="$HOME/.ssh/team_internal"

HADOOP_VERSION="3.4.3"
HADOOP_HOME="/opt/hadoop"
